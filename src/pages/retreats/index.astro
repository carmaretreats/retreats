---
import Layout from '../../layouts/Layout.astro';
import IntroStage from '../../components/IntroStage.astro';
import Hero from '../../components/Hero.astro';
import ImagineSection from '../../components/ImagineSection.astro';
import Divider from '../../components/Divider.astro';
import RetreatHighlights from '../../components/RetreatHighlights.astro';
import RetreatCards from '../../components/RetreatCards.astro';
import SloganBand from '../../components/SloganBand.astro';
import NextRetreats from '../../components/NextRetreats.astro';
import EinTag from '../../components/EinTag.astro';
import UnterkunftPreise from '../../components/UnterkunftPreise.astro';
import HostsSection from '../../components/HostsSection.astro';
import AboutSection from '../../components/AboutSection.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
import GallerySection from '../../components/GallerySection.astro';
import ContactSection from '../../components/ContactSection.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import BookingModal from '../../components/BookingModal.astro';
import AskModal from '../../components/AskModal.astro';
import data from '../../content/retreats-page.json';
const people = data.aboutSection.people;
---
<Layout>
  <IntroStage />
  <main>
    <Hero />
    <ImagineSection />
    <Divider motif="m20" />
    <RetreatCards />
    <Divider motif="m7" />
    <RetreatHighlights />
    <NextRetreats />
    <EinTag />
    <UnterkunftPreise />
    <HostsSection />
    <AboutSection person={people[0]} id="carmen" />
    <Divider motif="m4" />
    <AboutSection person={people[1]} id="mareen" flip={true} />
    <TestimonialSlider />
    <GallerySection />
    <ContactSection />
    <SloganBand />
    <FaqAccordion />
  </main>
  <BookingModal />
  <AskModal />
</Layout>
<script>
  import '../../scripts/brand.js';
</script>
