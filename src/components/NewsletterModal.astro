---
import NewsletterForm from './NewsletterForm.astro';
import { allgemein as a, format } from '../lib/inhalt.js';
---
<dialog class="modal newsletter-modal" id="newsletter">
  <div class="inner">
    <div class="head">
      <h3 class="h1" style="font-size:var(--fs-m)" set:html={format(a.newsletterTitel)} />
      <button type="button" class="close" data-close aria-label="Schließen">&#215;</button>
    </div>
    <p class="body">{a.newsletterText}</p>
    <NewsletterForm id="newsletter-modal" />
  </div>
</dialog>
