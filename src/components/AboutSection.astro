---
import { absaetze, pos } from '../lib/inhalt.js';
const { person, flip = false, id } = Astro.props;
---
<section class="section wrap about reveal" id={id}>
  <div class={flip ? 'about-grid flip' : 'about-grid'}>
    <div class="media"><img src={person.bild.src} alt={person.bild.alt} style={pos(person.bild)} /></div>
    <div class="cols2">
      <h2 class="h1">Über <em>{person.name}</em></h2>
      {absaetze(person.text).map(t => <p>{t}</p>)}
    </div>
  </div>
</section>
