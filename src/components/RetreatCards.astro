---
import { retreats } from '../lib/inhalt.js';
const cards = retreats.retreats.map(r => ({ ...r, meta: `${r.datum}, ${r.ort}${r.lehrer ? ` – mit ${r.lehrer}` : ''}` }));
const w = retreats.weitere;
---
<section class="section wrap cards-band reveal">
  <span class="label">{retreats.label}</span>
  <div class="cards">
    {cards.map(card => (
      <article class="card">
        <div class={`shot ${card.bildform === 'circle' ? 'circle' : 'square'}`}>
          <img src={card.bild} alt={card.titel} loading="lazy" />
        </div>
        <h3 class="h1 card-title">{card.titel}</h3>
        <p class="sub card-meta">{card.meta}</p>
        <p class="body card-text">{card.beschreibung}</p>
        <a class="link" href="#retreats">Mehr Infos</a>
      </article>
    ))}
    {w.anzeigen && (
      <article class="card">
        <div class={`shot ${w.bildform === 'circle' ? 'circle' : 'square'}`}>
          <img src={w.bild} alt={w.titel} loading="lazy" />
        </div>
        <h3 class="h1 card-title">{w.titel}</h3>
        <p class="sub card-meta">{w.datum}</p>
        <p class="body card-text">{w.beschreibung}</p>
        <button class="link" type="button" data-newsletter-open>{w.button}</button>
      </article>
    )}
  </div>
</section>
