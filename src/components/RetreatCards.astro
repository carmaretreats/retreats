---
import data from '../content/retreats-page.json';
const sec = data.nextRetreatsSection;
---
<section class="section wrap cards-band reveal">
  <span class="label">Nächste Retreats</span>
  <div class="cards">
    {sec.retreatCards.map(card => (
      <article class="card">
        <div class={`shot ${card.imageShape === 'circle' ? 'circle' : 'square'}`}>
          <img src={card.image} alt={card.title} loading="lazy" />
        </div>
        <h3 class="h1 card-title">{card.title}</h3>
        <p class="sub card-meta">{[card.date, card.location].filter(Boolean).join(', ')}</p>
        <p class="body card-text">{card.description}</p>
        {card.button.href.startsWith('#')
          ? <a class="link" href={card.button.href}>{card.button.label}</a>
          : <button class="link" type="button" data-ask>{card.button.label}</button>}
      </article>
    ))}
  </div>
</section>
