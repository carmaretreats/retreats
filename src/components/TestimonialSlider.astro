---
import data from '../content/retreats-page.json';
const items = data.testimonialSection.testimonials;
---
<section class="voices reveal" id="stimmen">
  <div class="wrap head">
    <span class="label">Stimmen unserer Gäste</span>
    <h2 class="h1">Sieben Tage, die <em>nachwirken.</em></h2>
  </div>
  <div class="vtrack">
    {items.map(t => (
      <figure class="vcard">
        <img src={t.src} alt={t.name} />
        <blockquote>{t.description}</blockquote>
        <figcaption class="label">{t.name}</figcaption>
      </figure>
    ))}
  </div>
</section>
