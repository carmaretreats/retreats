---
import { generalFaqs as faqs } from '../lib/faq.js';
---
<section class="section wrap split top text-first reveal mandala" id="faq" style="grid-template-columns: 1fr 2fr">
  <div class="stack">
    <span class="label">Retreat-Infos</span>
    <h2 class="h1">Antworten auf deine <em>Fragen.</em></h2>
    <a class="link" href="#" data-ask>Deine Frage schicken</a>
  </div>
  <div class="faq">
    {faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.question}</summary>
        <p class="answer">{f.answer}</p>
      </details>
    ))}
  </div>
</section>
