---
const {
  headline = 'Ankommen und',
  highlight = 'Aufatmen.',
  tag = 'Yoga-Retreats, die nachhaltig bewegen: eine Woche am Meer, in kleiner Gruppe und auf Deutsch. Hikkaduwa, Sri Lanka, im Januar und Februar 2027.',
} = Astro.props;
---
<section class="hero on-image">
  <img class="bg desktop" src="/media/img/C10.jpg" alt="" />
  <video class="bg mobile" src="/media/video/hero-portrait.mp4" poster="/media/img/hero-portrait-poster.jpg" autoplay muted loop playsinline preload="auto"></video>
  <div class="copy">
    <div class="stack">
      <h1 class="h1">{headline} <em>{highlight}</em></h1>
      <p class="tag">{tag}</p>
    </div>
    <a class="link" href="#kontakt">Jetzt anfragen</a>
  </div>
</section>
