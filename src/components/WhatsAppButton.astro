---
// wa.me erwartet die Nummer ohne Plus und ohne Leerzeichen.
const number = '4915229394860';
const text = encodeURIComponent('Hallo Carma Retreats, ich habe eine Frage zum Retreat.');
---
<div class="wa-dock">
  <div class="wa-bubble" hidden>
    <button class="wa-close" type="button" aria-label="Hinweis schließen">&times;</button>
    <p><strong>Hallo!</strong> Fragen zum Retreat? Schreib uns kurz auf WhatsApp, wir antworten meist noch am selben Tag.</p>
  </div>
  <a
  class="wa-fab"
  href={`https://wa.me/${number}?text=${text}`}
  target="_blank"
  rel="noopener"
  aria-label="Schreib uns auf WhatsApp"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 8.24 8.25c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.17 1.73 2.64 4.19 3.7.59.26 1.04.41 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"/>
  </svg>
  </a>
</div>
