---
import { galerie as g, pos } from '../lib/inhalt.js';
// Das Raster setzt genau fünf Bilder in feste Felder, das CMS erzwingt die Anzahl
const slots = ['g-a', 'g-b', 'g-c', 'g-d', 'g-e'];
---
<section class="gallery reveal">
  <div class="wrap">
    <div class="ghead">
      <span class="label">{g.label}</span>
      <span class="label muted">{g.untertitel}</span>
    </div>
    <div class="ggrid">
      {g.bilder.slice(0, slots.length).map((b, i) => <img class={slots[i]} src={b.src} alt={b.alt} style={pos(b)} />)}
    </div>
  </div>
</section>
