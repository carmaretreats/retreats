---
import { allgemein as a, waLink } from '../lib/inhalt.js';
---
<dialog class="modal chat" id="ask">
  <form class="inner" onsubmit="return false">
    <div class="head">
      <h3 class="h1" style="font-size:var(--fs-m)">Wir sind <em>für dich da.</em></h3>
      <button type="button" class="close" data-close aria-label="Schließen">&#215;</button>
    </div>
    <div class="ask-body">
      <p class="body">{a.frageText}</p>
      <label class="field"><input type="email" name="email" placeholder="Deine E-Mail" required></label>
      <label class="field"><input type="tel" name="phone" placeholder="Telefon / WhatsApp (optional)" autocomplete="tel"></label>
      <label class="field"><textarea name="question" placeholder="Was möchtest du wissen?" required></textarea></label>
      <p class="body status" data-status role="alert"></p>
      <div class="nav"><a class="link wa" href={waLink(a.whatsappText)} target="_blank" rel="noopener">Lieber per WhatsApp</a><button type="button" class="btn" data-send>Frage senden</button></div>
    </div>
    <div class="thanks">
      <h3 class="h1" style="font-size:var(--fs-m)">Danke für deine Frage, <em>wir freuen uns.</em></h3>
      <p class="body">Wie schön, dass du dich meldest. Wir antworten dir gern und meist noch am selben Tag.</p>
    </div>
  </form>
</dialog>
