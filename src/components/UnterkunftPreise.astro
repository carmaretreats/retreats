---
import { bookingFaqs } from '../lib/faq.js';
import { freeSlots } from '../lib/verfuegbarkeit.js';
import { unterkunft as u, retreats, format, euro, ortKurz, pos } from '../lib/inhalt.js';
const { availability = null } = Astro.props;

const dates = retreats.retreats.map((r) => ({
  datum: r.datum,
  ausgebucht: Boolean(r.ausgebucht),
  zeile: `${r.datum} in ${ortKurz(r)}${r.lehrer ? ` mit ${r.lehrer}` : ''}`,
}));
// Im CMS ausgebuchte Retreats zählen für den Zimmer-Hinweis nicht mit
const open = dates.filter((d) => !d.ausgebucht);
const month = (d) => d.match(/[A-Za-zäöü]+ \d{4}/)?.[0] ?? d;
// Hinweis pro Zimmer: "Ausgebucht" wenn in jedem offenen Retreat 0 frei, sonst die vollen Monate
const soldOut = (room) => {
  const fullDates = open.filter((d) => freeSlots(availability, d.datum, room) === 0);
  if (!fullDates.length) return '';
  return fullDates.length === open.length ? 'Ausgebucht' : `${fullDates.map((d) => month(d.datum).split(' ')[0]).join(' und ')} ausgebucht`;
};
---
<section class="section wrap split top text-first reveal" id="unterkunft">
  <div class="stack">
    <span class="label">{u.label}</span>
    <h2 class="h1" set:html={format(u.titel)} />
    <div class="rows roomlist">
      {u.zimmer.map(r => (
        <div class="row">
          <button class="thumb" type="button" data-photos={JSON.stringify(r.bilder)} data-title={r.name} aria-label={`Fotos ansehen: ${r.name}`}>
            <img src={r.bilder[0]} alt="" style={pos(r)} />
          </button>
          <div class="txt"><span>{r.name}</span>{soldOut(r.name) && <span class="soldout">{soldOut(r.name)}</span>}</div>
          <span class="price">{euro(r.preis)}</span>
        </div>
      ))}
    </div>
    <div class="fee">
      <span>Dazu kommt die Retreatgebühr</span>
      <span class="fee-price">{euro(u.retreatgebuehr)} pro Person</span>
    </div>
    <div class="faq">
      {bookingFaqs.map(f => (
        <details>
          <summary>{f.frage}</summary>
          <p class="answer">{f.antwort}</p>
        </details>
      ))}
    </div>
  </div>
  <div class="rooms-media">
    <p class="body">{u.text}</p>
    <div class="squares">
      {u.bilder.map(b => <img src={b.src} alt={b.alt} style={pos(b)} />)}
    </div>
    <div class="rows dates">
      {dates.map(d => (
        <div class="row between">
          <span>{d.zeile}</span>
          {d.ausgebucht ? <span class="soldout">Ausgebucht</span> : <a class="book-btn" href="#kontakt" data-retreat={d.datum}>Jetzt buchen</a>}
        </div>
      ))}
    </div>
    <a class="link guide" href={u.infoGuide} target="_blank" rel="noopener">Info-Guide als PDF</a>
  </div>
</section>

<dialog class="modal lightbox" id="lightbox" aria-label="Zimmerfotos">
  <figure>
    <img alt="" />
    <div class="lb-foot">
      <figcaption class="label"></figcaption>
      <div class="lb-nav">
        <button type="button" class="varrow" data-step="-1" aria-label="Vorheriges Foto">&larr;</button>
        <button type="button" class="varrow" data-step="1" aria-label="Nächstes Foto">&rarr;</button>
      </div>
    </div>
  </figure>
  <button type="button" class="close" data-close aria-label="Schließen">&#215;</button>
</dialog>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement;
  const img = box.querySelector('img')!;
  const cap = box.querySelector('figcaption')!;
  const arrows = box.querySelectorAll<HTMLButtonElement>('[data-step]');
  let photos: string[] = [];
  let i = 0;
  const show = (n: number) => {
    i = (n + photos.length) % photos.length;
    img.src = photos[i];
    cap.textContent = photos.length > 1 ? `${cap.dataset.title} · ${i + 1}/${photos.length}` : cap.dataset.title!;
  };
  document.querySelectorAll<HTMLButtonElement>('.roomlist .thumb').forEach(b =>
    b.addEventListener('click', () => {
      photos = JSON.parse(b.dataset.photos!);
      cap.dataset.title = b.dataset.title;
      box.classList.toggle('single', photos.length < 2);
      show(0);
      box.showModal();
    })
  );
  arrows.forEach(a => a.addEventListener('click', () => show(i + Number(a.dataset.step))));
  box.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') show(i + 1);
    if (e.key === 'ArrowLeft') show(i - 1);
  });
  box.querySelector('[data-close]')!.addEventListener('click', () => box.close());
  box.addEventListener('click', e => { if (e.target === box) box.close(); });
</script>

<style>
  /* hebt den Spalten-Abstand auf, der Link rueckt an die Terminzeilen */
  .guide { margin-top: calc(-1 * clamp(28px, 3.5vw, 44px)); }
  .roomlist .row + .row { border-top: 0; }
  .dates .soldout { font-size: var(--fs-nav); letter-spacing: 0.04em; text-transform: uppercase; color: var(--terra); }
  .faq details:first-of-type { border-top: 0; }
  .faq details:last-of-type { border-bottom: 0; }
  @media (max-width: 860px) {
    /* Auf dem Handy loesen sich beide Spalten auf, alle Bloecke liegen direkt im
       Sektions-Grid und werden neu sortiert: der Absatz und die Fotos erklaeren
       die Zimmerliste und stehen deshalb davor. */
    #unterkunft > .stack, #unterkunft > .rooms-media { display: contents; }
    #unterkunft { row-gap: 24px; }
    #unterkunft .label { order: 0; }
    #unterkunft .h1 { order: 1; }
    #unterkunft .rooms-media .body { order: 2; margin-top: 0; }
    #unterkunft .squares { order: 3; }
    #unterkunft .roomlist { order: 4; }
    #unterkunft .fee { order: 5; }
    #unterkunft .faq { order: 6; }
    #unterkunft .dates { order: 7; margin-top: 16px; }
    #unterkunft .guide { order: 8; margin-top: -8px; }
  }
</style>
