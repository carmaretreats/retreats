---
const rooms = [
  { name: 'Stockbett im Dreibettzimmer', price: '200 Euro', img: '/media/img/monara-rest.jpg' },
  { name: 'Doppelbett im Dreibettzimmer', price: '350 Euro', img: '/media/img/monara-bed-1-.jpg' },
  { name: 'Einzelzimmer Standard (EG)', price: '550 Euro', img: '/media/img/Hikkaduwa01.webp' },
  { name: 'Einzelzimmer Deluxe (1. OG)', price: '650 Euro', img: '/media/img/monara-balcony-1-.jpg' },
  { name: 'Einzelzimmer Premium (1. OG)', price: '750 Euro', img: '/media/img/Hikkaduwa04.webp' },
];
---
<section class="section wrap split top text-first reveal" id="unterkunft">
  <div class="stack">
    <span class="label">Die Infos</span>
    <h2 class="h1">Unterkunft & <em>Preise</em></h2>
    <p class="body">Die Retreatgebühr für Yogaklassen und Rahmenprogramm beträgt pro Person 1100 Euro. Zusätzlich buchst du Zimmer + Mahlzeiten (Brunch & Dinner) direkt bei der Unterkunft, dem wunderschönen neugebauten Retreat-Center Bunky Monkey in Hikkaduwa.</p>
    <div class="rows roomlist">
      {rooms.map((r, i) => (
        <div class={i === 0 ? 'row strong' : 'row'}>
          <img src={r.img} alt="" />
          <div class="txt"><span>{r.name}</span></div>
          <span class="price">{r.price}</span>
        </div>
      ))}
    </div>
    <div class="fee">
      <span>Dazu kommt die Retreatgebühr</span>
      <span class="fee-price">1100 Euro pro Person</span>
    </div>
    <a class="link" href="#kontakt">Zimmer anfragen</a>
  </div>
  <div class="rooms-media">
    <img src="/media/img/Hikkaduwa02.webp" alt="Die Shala" />
    <div class="pair">
      <img src="/media/img/monara-bed-1-.jpg" alt="" />
      <img src="/media/img/monara-balcony-1-.jpg" alt="" />
    </div>
  </div>
</section>
