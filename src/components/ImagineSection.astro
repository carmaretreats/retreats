---
import { stellDirVor as s, format, pos } from '../lib/inhalt.js';
---
<section class="section wrap split" id="stell">
  <div class="media">
    <img src={s.bild.src} alt={s.bild.alt} style={pos(s.bild)} />
    <video src="/media/video/hero-portrait.mp4" poster="/media/img/hero-portrait-poster.jpg" autoplay muted loop playsinline preload="metadata"></video>
  </div>
  <div class="stack">
    <span class="label">{s.label}</span>
    <h2 class="h1" set:html={format(s.titel)} />
    {s.absaetze.map(t => <p class="body">{t}</p>)}
    <button class="link" type="button" data-ask>{s.button}</button>
  </div>
</section>
