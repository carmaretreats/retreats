---
const { id = 'newsletter-footer' } = Astro.props;
---
<form class="newsletter-form" action="/api/newsletter" method="post" data-newsletter>
  <label class="sr-only" for={`${id}-email`}>Deine E-Mail-Adresse</label>
  <div class="newsletter-fields">
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="Deine E-Mail-Adresse" maxlength="254" required />
    <button class="book-btn" type="submit">Eintragen</button>
  </div>
  <label class="newsletter-consent">
    <input type="checkbox" name="consent" value="yes" required />
    <span>Ich möchte den Newsletter von CARMA Retreats erhalten. Ich kann mich jederzeit abmelden. Hinweise zum Umgang mit meinen Daten finde ich in der <a href="/datenschutz">Datenschutzerklärung</a>.</span>
  </label>
  <div class="newsletter-trap" aria-hidden="true">
    <label>Webseite<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
  </div>
  <p class="newsletter-status" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach(form => {
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const status = form.querySelector<HTMLElement>('[role="status"]')!;
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (button.disabled) return;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.textContent = 'Anmeldung wird gesendet …';
      try {
        const response = await fetch(form.action, {
          method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' },
        });
        const result = await response.json();
        status.textContent = result.message;
        if (response.ok) form.reset();
      } catch {
        status.textContent = 'Die Anmeldung ist gerade nicht möglich. Bitte versuche es später erneut.';
      } finally {
        button.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .newsletter-form { display: grid; gap: 18px; width: 100%; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  /* Feld und Button auf einer Linie: die Unterkante des Feldes liegt auf der Button-Unterkante */
  .newsletter-fields { display: flex; flex-wrap: wrap; align-items: stretch; gap: 16px 20px; }
  input[type="email"] { min-width: 0; flex: 1 1 200px; border: 0; border-bottom: 1px solid currentColor; border-radius: 0; background: transparent; color: inherit; padding: 8px 0; font: inherit; font-size: var(--fs-s); }
  input::placeholder { color: inherit; opacity: 0.6; }
  button:disabled { cursor: wait; opacity: 0.7; }
  .newsletter-consent { display: flex; align-items: flex-start; gap: 10px; font-size: 12px; line-height: 1.6; }
  .newsletter-consent input { flex: 0 0 auto; margin-top: 4px; accent-color: var(--orange); }
  .newsletter-consent a { text-decoration: underline; }
  .newsletter-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .newsletter-status { font-size: 14px; margin: 0; }
  .newsletter-status:empty { display: none; }
</style>
