---
import { tagesablauf as t, format, pos } from '../lib/inhalt.js';
---
<section class="day" id="tag">
  <div class="wrap reveal day-split">
    <div class="day-pics">
      <img src={t.bild1.src} alt={t.bild1.alt} style={pos(t.bild1)} />
      <img src={t.bild2.src} alt={t.bild2.alt} style={pos(t.bild2)} />
    </div>
    <div class="day-copy">
      <span class="label">{t.label}</span>
      <h2 class="h1" set:html={format(t.titel)} />
      <div class="rows">
        {t.ablauf.map(a => (
          <div class="row"><span class="t">{a.zeit}</span><div><span>{a.titel}</span><span class="muted">{a.text}</span></div></div>
        ))}
      </div>
      <div><a class="book-btn" href="#kontakt">Jetzt buchen</a></div>
    </div>
  </div>
</section>
