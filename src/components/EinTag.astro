<section class="day" id="tag">
  <div class="wrap reveal day-split">
    <div class="day-pics">
      <img src="/media/img/C21.jpg" alt="Zwei Teilnehmerinnen im Baum" style="object-position:center 22%" />
      <img src="/media/img/C14.jpg" alt="Praxis auf der Terrasse" />
    </div>
    <div class="day-copy">
      <span class="label">Dein Tag</span>
      <h2 class="h1">Ein Tag bei <em>Carma Retreats</em></h2>
      <div class="rows">
        <div class="row"><span class="t">7.30</span><div><span>Meditation und Pranayama</span><span class="muted">Starte den Tag in Stille, umgeben von den Geräuschen der Natur.</span></div></div>
        <div class="row"><span class="t">8.00</span><div><span>Ayurvedischer Morgentee</span><span class="muted">Teezeit in Stille - bleib ganz bei Dir.</span></div></div>
        <div class="row"><span class="t">8.30</span><div><span>Morning Flow Yoga</span><span class="muted">Bewege dich im Rhythmus der Insel. Dein Körper erwacht und wird gestärkt bei einer fließenden Yoga Praxis.</span></div></div>
        <div class="row"><span class="t">10.30</span><div><span>Community Brunch</span><span class="muted">Brich das Schweigen und nähre dich mit guten Gesprächen und frischen, lokal inspirierten Gerichten.</span></div></div>
        <div class="row"><span class="t">15.00</span><div><span>Fruchtplatte und Get-Together</span><span class="muted">Am Nachmittag für alle, die nicht unterwegs sind und die Community genießen wollen.</span></div></div>
        <div class="row"><span class="t">16.00</span><div><span>Ausflug (2 Mal die Woche):</span><span class="muted">Komm in Kontakt mit der einheimischen Kultur beim Töpfern, Kochen, auf einer Bootstour oder bei einem Besuch im Tempel.</span></div></div>
        <div class="row"><span class="t">17.00</span><div><span>Abendpraxis</span><span class="muted">Bring Körper und Geist zur Ruhe und beende den Tag mit einer erdenden Yin oder Restorativen Praxis.</span></div></div>
        <div class="row"><span class="t">19.00</span><div><span>Abendessen</span><span class="muted">Wir runden den Tag ab mit einem leckeren, gemeinsamen Essen.</span></div></div>
        <div class="row"><span class="t">20.30</span><div><span>Ausklang in Stille</span><span class="muted">Wir enden den Tag wie wir ihn begonnen haben, ganz bei uns in Stille.</span></div></div>
      </div>
      <div><a class="link" href="#kontakt">Jetzt buchen</a></div>
    </div>
  </div>
  <div class="fullbleed quote-band on-image reveal">
    <img class="band-still" src="/media/img/C13.jpg" alt="Carmen unterrichtet in der Shala" />
    <video class="band-video" src="/media/video/mid-portrait.mp4" poster="/media/img/mid-portrait-poster.jpg" autoplay muted loop playsinline preload="none"></video>
    <div class="band-copy">
      <img class="band-mark" src="/media/logo/Markenzeichen---Weiss.svg" alt="" />
      <p class="band-quote">Ayubowan &ndash; <em>möge dein Leben lang sein.</em></p>
      <span class="label">Der Gruß, mit dem dich Sri Lanka empfängt</span>
    </div>
  </div>
</section>
