---
const seite = [
  { label: 'Retreats', href: '#retreats' },
  { label: 'Unterkunft', href: '#unterkunft' },
  { label: 'Tagesablauf', href: '#tag' },
  { label: 'Über uns', href: '#hosts' },
  { label: 'Buchen', href: '#kontakt' },
];
const rechtliches = [
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutzerklärung', href: '/datenschutz' },
  { label: 'Cookie-Einstellungen', href: '#' },
];
---
<footer class="site-footer">
  <div class="top">
    <div class="stack" style="gap:24px">
      <span class="label">Newsletter</span>
      <p>Weitere Retreats in Planung - melde dich hier für unseren Newsletter an und erfahre mehr!</p>
      <div class="newsletter">
        <input type="email" placeholder="Deine E-Mail" />
        <a class="link" href="/newsletter-soon">In Newsletter eintragen</a>
      </div>
    </div>
    <div class="cols">
      <div><span class="label">Seite</span>{seite.map(i => <a href={i.href}>{i.label}</a>)}</div>
      <div><span class="label">Kontakt</span><a href="#">Instagram</a><a href="https://wa.me/4915229394860" target="_blank" rel="noopener">WhatsApp</a><a href="#">E-Mail</a></div>
      <div><span class="label">Rechtliches</span>{rechtliches.map(i => <a href={i.href}>{i.label}</a>)}</div>
    </div>
  </div>
  <div class="bottom">
    <div class="wordmark"><img src="/media/logo/Carna-Retreats---Links---Weiss.svg" alt="Carma Retreats" /></div>
    <span class="label">© 2026 Carma Retreats · Alle Rechte vorbehalten</span>
  </div>
</footer>
