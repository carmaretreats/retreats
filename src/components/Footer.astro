---
import NewsletterForm from './NewsletterForm.astro';
import { allgemein as a, buchung, format, waLink } from '../lib/inhalt.js';
const seite = [
  { label: 'Retreats', href: '#retreats' },
  { label: 'Unterkunft', href: '#unterkunft' },
  { label: 'Tagesablauf', href: '#tag' },
  { label: 'Über uns', href: '#hosts' },
  { label: 'Buchen', href: '#kontakt' },
];
const rechtliches = [
  { label: 'Impressum', href: '/impressum' },
  { label: 'AGB', href: buchung.agb },
  { label: 'Datenschutzerklärung', href: '/datenschutz' },
  { label: 'Cookie-Einstellungen', href: '#' },
];
---
<footer class="site-footer">
  <div class="top">
    <div class="stack newsletter-block">
      <span class="label">Newsletter</span>
      <h3 class="h1" set:html={format(a.newsletterTitel)} />
      <p>{a.newsletterText}</p>
      <NewsletterForm />
    </div>
    <div class="cols">
      <div><span class="label">Seite</span>{seite.map(i => <a href={i.href}>{i.label}</a>)}</div>
      <div><span class="label">Kontakt</span><a href={a.instagram} target="_blank" rel="noopener">Instagram</a><a href={waLink()} target="_blank" rel="noopener">WhatsApp</a><a href={`mailto:${a.email}`}>E-Mail</a></div>
      <div><span class="label">Rechtliches</span>{rechtliches.map(i => <a href={i.href}>{i.label}</a>)}</div>
    </div>
  </div>
  <div class="bottom">
    <div class="wordmark"><img src="/media/logo/Carna-Retreats---Links---Weiss.svg" alt="CARMA Retreats" /></div>
    <span class="label">{a.copyright}</span>
  </div>
</footer>
