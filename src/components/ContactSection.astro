---
import { buchung as b, format, pos } from '../lib/inhalt.js';
---
<section class="section wrap split top text-first contact reveal" id="kontakt">
  <div class="stack">
    <span class="label">{b.label}</span>
    <h2 class="h1" set:html={format(b.titel)} />
    <p class="body">{b.text}</p>
    <div class="rows steplist">
      {b.schritte.map((s, i) => <div class="row"><span class="t label">{String(i + 1).padStart(2, '0')}</span><span>{s}</span></div>)}
    </div>
    <div><a class="link" href="#kontakt">{b.link}</a></div>
  </div>
  <div class="media"><img src={b.bild.src} alt={b.bild.alt} style={pos(b.bild)} /></div>
</section>
