---
import { highlights as h, format, pos } from '../lib/inhalt.js';
---
<section class="section wrap split top expect">
  <div class="stack">
    <span class="label">{h.label}</span>
    <h2 class="h1" set:html={format(h.titel)} />
    <div class="items">
      {h.punkte.map(p => (
        <div class="item"><div><span>{p.titel}</span><span class="muted">{p.text}</span></div></div>
      ))}
      <div class="item cta"><a class="book-btn" href="#kontakt">Jetzt buchen</a></div>
    </div>
  </div>
  <div class="pics">
    <img src={h.bild1.src} alt={h.bild1.alt} style={pos(h.bild1)} />
    <img src={h.bild2.src} alt={h.bild2.alt} style={pos(h.bild2)} />
  </div>
</section>
