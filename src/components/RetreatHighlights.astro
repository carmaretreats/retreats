---
import data from '../content/retreats-page.json';
---
<section class="section wrap split top expect reveal">
  <div class="stack">
    <span class="label">Was dich erwartet</span>
    <h2 class="h1">Eine Auszeit in der Ferne, die <em>nachhaltig bewegt.</em></h2>
    <div class="items">
      {data.retreatHighlightsSection.highlights.map(h => (
        <div class="item"><div><span>{h.title}</span><span class="muted">{h.text}</span></div></div>
      ))}
    </div>
    <a class="link" href="#retreats">Mehr erfahren</a>
  </div>
  <div class="pics">
    <img src="/media/img/C12.jpg" alt="Die Shala am Morgen" />
    <img src="/media/img/8656.jpg" alt="Meditation in der Shala" />
  </div>
</section>
