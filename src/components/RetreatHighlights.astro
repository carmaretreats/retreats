---
import data from '../content/retreats-page.json';
---
<section class="section wrap split top expect">
  <div class="stack">
    <span class="label">Was dich erwartet</span>
    <h2 class="h1">Eine Auszeit in der Ferne, die <em>nachhaltig bewegt.</em></h2>
    <div class="items">
      {data.retreatHighlightsSection.highlights.map(h => (
        <div class="item"><div><span>{h.title}</span><span class="muted">{h.text}</span></div></div>
      ))}
      <div class="item cta"><a class="book-btn" href="#kontakt">Jetzt buchen</a></div>
    </div>
  </div>
  <div class="pics">
    <img src="/media/img/kunde-24.jpg" alt="Namaste im Abendlicht unter Palmen" />
    <img src="/media/img/kunde-27.jpg" alt="Yoga auf der Terrasse zwischen Palmen" />
  </div>
</section>
