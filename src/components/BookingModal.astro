---
import { freeSlots } from '../lib/verfuegbarkeit.js';
import { RETREATS, ROOMS } from '../lib/retreats.js';
import { retreats, unterkunft, buchung as b, format, euro, gesamtpreis, pos } from '../lib/inhalt.js';
const { availability = null } = Astro.props;
// Ausgebuchte Zimmer je Retreat, das Skript sperrt sie im Zimmer-Schritt
const full = Object.fromEntries(RETREATS.map((r) => [r, ROOMS.filter((z) => freeSlots(availability, r, z) === 0)]));
const abPreis = Math.min(...unterkunft.zimmer.map(gesamtpreis));
// Vorausgewählt ist das erste Retreat, das im CMS nicht als ausgebucht markiert ist
const first = Math.max(0, retreats.retreats.findIndex((r) => !r.ausgebucht));
---
<dialog class="modal" id="booking" data-full={JSON.stringify(full)}>
  <form class="inner" onsubmit="return false">
    <div class="head">
      <span class="label">Buchungsanfrage</span>
      <button type="button" class="close" data-close aria-label="Schließen">&#215;</button>
    </div>
    <div class="steps"><button type="button" class="on">01 Retreat</button><button type="button">02 Zimmer</button><button type="button">03 Kontakt</button></div>

    <div class="panel on">
      <div class="options">
        {retreats.retreats.map((r, i) => (
          <label class:list={['option', { full: r.ausgebucht }]}><input type="radio" name="retreat" value={r.datum} checked={i === first} disabled={r.ausgebucht}><img src={r.buchungsbild || r.bild} alt=""><span class="txt"><span>{r.datum}</span></span><span class="price">ab {euro(abPreis)}</span></label>
        ))}
      </div>
    </div>

    <div class="panel">
      <div class="options">
        {unterkunft.zimmer.map((z, i) => (
          <label class="option"><input type="radio" name="room" value={z.name} checked={i === 0}><img src={z.bilder[0]} alt="" style={pos(z)}><span class="txt"><span>{z.name}</span></span><span class="price">{euro(gesamtpreis(z))}</span></label>
        ))}
        <label class="option"><input type="radio" name="room" value="Noch unsicher"><span class="thumb-gap"></span><span class="txt"><span>Noch unsicher</span></span><span class="price">Wir beraten dich</span></label>
      </div>
      <span class="fine">{b.preisHinweis}</span>
    </div>

    <div class="panel">
      <div class="summary">
        <div><span class="label">Retreat</span><span data-sum="retreat"></span></div>
        <div><span class="label">Zimmer</span><span data-sum="room"></span></div>
      </div>
      <div class="two">
        <label class="field"><span class="label">Name*</span><input type="text" name="name" placeholder="Dein Name" required></label>
        <label class="field"><span class="label">E-Mail*</span><input type="email" name="email" placeholder="Deine E-Mail" required></label>
      </div>
      <label class="field"><span class="label">Telefon / WhatsApp</span><input type="tel" name="phone" placeholder="Optional, mit Ländervorwahl, z. B. +49 …" autocomplete="tel"></label>
      <label class="field"><span class="label">Nachricht</span><textarea name="message" placeholder="Optional"></textarea></label>
      <p class="body status" data-status role="alert"></p>
    </div>

    <div class="nav">
      <button type="button" class="btn back" data-back>Zurück</button>
      <button type="button" class="btn" data-next>Weiter</button>
    </div>

    <div class="thanks">
      <h3 class="h1" style="font-size:var(--fs-m)" set:html={format(b.dankeTitel)} />
      <p class="body">{b.dankeText}</p>
      <p class="body note">{b.dankeHinweis}</p>
      <label class="agb-check"><input type="checkbox" data-agb><span>Ich habe die <a href={b.agb} target="_blank" rel="noopener">AGB</a> gelesen und bin damit einverstanden.</span></label>
      <div class="nav">
        <button type="button" class="link ghost" data-close>Erst mal abwarten</button>
        <a class="link" href={b.anzahlungLink} target="_blank" rel="noopener" data-pay aria-disabled="true">Anzahlen und Platz sichern</a>
      </div>
    </div>
  </form>
</dialog>
