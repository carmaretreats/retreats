---
const nav = [
  { label: 'Retreats', href: '#retreats' },
  { label: 'Unterkunft', href: '#unterkunft' },
];
const cta = '#kontakt';
const menu = [
  { label: 'Retreats & Termine', href: '#retreats' },
  { label: 'Unterkunft & Preise', href: '#unterkunft' },
  { label: 'Tagesablauf', href: '#tag' },
  { label: 'Über uns', href: '#hosts' },
  { label: 'Stimmen', href: '#stimmen' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Kontakt', href: '#kontakt' },
];
---
<header class="site-header">
  <nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Retreats Menü">
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
      <span class="menu-word">Retreats</span>
    </button>
    {nav.map(item => <span><a href={item.href}>{item.label}</a></span>)}
  </nav>
  <a class="wordmark" href="/retreats" aria-label="CARMA Retreats">
    <img class="light" src="/media/logo/Carma---Weiss.svg" alt="CARMA Retreats" />
    <img class="dark" src="/media/logo/Carma---Schwarz.svg" alt="CARMA Retreats" />
  </a>
  <nav class="right">
    <span><a href="#hosts">Über uns</a></span>
    <a class="cta book-btn" href={cta}>
      <i class="cta-long">Jetzt buchen</i><i class="cta-short">Buchen</i>
    </a>
  </nav>
  <div class="mobile-menu" id="mobile-menu">
    <ul>
      {menu.map(item => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <a class="book-btn" href={cta}>Jetzt buchen</a>
  </div>
  <div class="menu-backdrop"></div>
</header>


<style>
  .site-header {
    position: sticky;
    top: 0;
    min-height: 72px;
    padding: 16px 32px;
    background: var(--creme);
    color: var(--ink);
  }
  .site-header nav { justify-content: space-between; max-width: 340px; }
  .site-header nav.right { justify-self: end; width: 100%; }
  .site-header .wordmark img { height: 36px; }
  .site-header .wordmark .light { display: none; }
  .site-header .wordmark .dark { display: block; }
  .menu-toggle, .mobile-menu, .menu-backdrop { display: none; }
  @media (max-width: 1100px) and (min-width: 861px) {
    .site-header nav { max-width: 260px; gap: 24px; }
  }
  @media (max-width: 860px) {
    .site-header, .site-header.scrolled {
      min-height: 80px;
      padding: 20px;
    }
    .site-header { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
    .site-header nav { font-size: 11px; }
    .site-header nav.right { justify-content: flex-end; }
    .site-header .wordmark img, .site-header.scrolled .wordmark img { height: 28.8px; }
    .site-header .cta { margin-left: 0; }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      margin: -8px 0;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      cursor: pointer;
    }
    .bars { position: relative; width: 16px; height: 7px; }
    .bars i {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.25s ease, top 0.25s ease;
    }
    .bars i:first-child { top: 0; }
    .bars i:last-child { top: 5.5px; }
    .menu-open .bars i { top: 2.75px; }
    .menu-open .bars i:first-child { transform: rotate(45deg); }
    .menu-open .bars i:last-child { transform: rotate(-45deg); }

    .mobile-menu {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 1;
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      padding: 4px 20px 28px;
      background: var(--creme) url("/media/img/paper.jpg") center / cover;
      border-top: 1px solid var(--line);
      box-shadow: 0 1px 0 rgba(154, 71, 54, 0.18);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s 0.2s;
    }
    /* WhatsApp-Dock liegt auf 30 und wuerde sonst den Buchen-Button im Menue verdecken */
    .site-header.menu-open { z-index: 40; transform: none; }
    .menu-open .mobile-menu {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
    .mobile-menu ul { list-style: none; margin: 0 0 24px; padding: 0; }
    .mobile-menu li { border-bottom: 1px solid var(--line); }
    .mobile-menu li a {
      display: block;
      padding: 17px 0;
      font-family: var(--label);
      font-size: var(--fs-caps);
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }
    .mobile-menu .book-btn { display: block; text-align: center; }

    .menu-backdrop {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 100dvh;
      background: rgba(53, 42, 31, 0.35);
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.2s ease, visibility 0s 0.2s;
    }
    .menu-open .menu-backdrop { visibility: visible; opacity: 1; transition-delay: 0s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bars i, .mobile-menu, .menu-backdrop { transition: none; }
  }
</style>
