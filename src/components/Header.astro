---
const nav = [
  { label: 'Retreats', href: '#retreats' },
  { label: 'Unterkunft', href: '#unterkunft' },
  { label: 'Tagesablauf', href: '#tag' },
];
const cta = 'https://calendly.com/carma-retreats/kennenlernen';
---
<header class="site-header">
  <nav>
    <span class="m-only">Menü</span>
    {nav.map(item => <span><a href={item.href}>{item.label}</a></span>)}
  </nav>
  <a class="wordmark" href="/retreats" aria-label="Carma Retreats">
    <img class="light" src="/media/logo/Carma---Weiss.svg" alt="Carma Retreats" />
    <img class="dark" src="/media/logo/Carma---Schwarz.svg" alt="Carma Retreats" />
  </a>
  <nav class="right">
    <span><a href="#hosts">Über uns</a></span>
    <a class="cta" href={cta} target="_blank" rel="noopener">
      <i class="cta-long">Lerne uns kennen</i><i class="cta-short">Kennenlernen</i>
    </a>
  </nav>
</header>
<img class="symbol" src="/media/logo/Markenzeichen---Weiss.svg" alt="" />
