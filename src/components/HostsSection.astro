---
import { ueberUns as u, format, pos } from '../lib/inhalt.js';
---
<section class="section wrap split hosts on-paper reveal" id="hosts">
  <div class="media"><img src={u.bild.src} alt={u.bild.alt} style={pos(u.bild)} /></div>
  <div class="stack">
    <span class="label">{u.label}</span>
    <h2 class="h1" set:html={format(u.titel)} />
    {u.absaetze.map(t => <p class="body">{t}</p>)}
    <div class="thumbs">
      {u.kleineBilder.map(b => <img src={b.src} alt={b.alt} style={pos(b)} />)}
    </div>
  </div>
</section>
